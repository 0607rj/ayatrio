NODE_ENV=development
PORT=5000
MONGODB_URI=your_mongodb_connection_string
GOOGLE_SHEET_ID=your_google_sheet_id
# Set this to either ./serviceAccount.json locally or the raw JSON string on Render
GOOGLE_SERVICE_ACCOUNT_JSON=./serviceAccount.json
GOOGLE_SHEET_TITLE=cookie_import
ENABLE_SHEET_EXPORT=true
SHEET_EXPORT_INTERVAL_MINUTES=10
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=30d
CORS_ORIGIN=http://localhost:3000

# Fixed Google Meet Link for Instant Calls
INSTANT_CALL_MEET_LINK=https://meet.google.com/your-meet-link

# Google SMTP Configuration
GOOGLE_EMAIL=your_gmail_address@gmail.com
GOOGLE_APP_PASSWORD=your_google_app_password

# Admin Email for Notifications
ADMIN_EMAIL=admin@chartersbusiness.com

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key"
# OR provide the full JSON string
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", ...}'

# Internal admin API security
INTERNAL_SERVICE_KEY=change_this_shared_service_key
INTERNAL_SERVICE_KEYS=
# Key rotation (recommended): either JSON map or CSV id:key pairs in INTERNAL_SERVICE_KEYS
# Example: {"pb-primary":"key1","pb-secondary":"key2"}
INTERNAL_SERVICE_KEY_RING_JSON=
INTERNAL_SHARED_SECRET=change_this_internal_shared_secret
INTERNAL_ACTING_TOKEN_ISSUER=profile-branding
INTERNAL_ALLOWED_IPS=